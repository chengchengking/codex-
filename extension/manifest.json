{
   "manifest_version": 3,
   "name": "Codex Auth Helper",
   "version": "2.1.0",
   "short_name": "Codex Auth Helper",
   "description": "在本地导出已登录 ChatGPT 会话配置，支持一键复制配置与本地 auth.json 解析校验。请勿分享生成的凭证文件。",
   "action": {
      "default_popup": "popup/popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "host_permissions": [ "https://chatgpt.com/" ],
   "permissions": [ "downloads", "clipboardWrite" ]
}
