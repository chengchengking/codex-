name = "codex-auth"
main = "worker.js"
compatibility_date = "2026-06-25"

[vars]
CODEX_CODE_PREFIX = "CXA"
CODEX_CODE_TZ_OFFSET_MINUTES = "480"
QQ_GROUP_LABEL = "QQ群：请替换为你的群号"
QQ_GROUP_URL = "https://qm.qq.com/q/REPLACE_WITH_YOUR_QQ_GROUP_LINK"
# Open access: anyone can use the bookmarklet without a daily code.
# Set to "false" to require the QQ-group daily code again.
OPEN_ACCESS = "true"

# Add your real KV namespace id after creating it:
# npx wrangler kv namespace create CODEX_AUTH_STORE --binding CODEX_AUTH_STORE
[[kv_namespaces]]
binding = "CODEX_AUTH_STORE"
id = "replace-with-kv-namespace-id"

# Do not put secrets here.
# Configure them with:
# wrangler secret put CODEX_DAILY_SECRET
# wrangler secret put CODEX_ADMIN_CODE
