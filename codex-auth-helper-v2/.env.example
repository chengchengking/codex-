# Copy this file to .env, then replace the secret before deploying.
# Do not commit .env. The same CODEX_DAILY_SECRET must be configured in Cloudflare Workers.
CODEX_DAILY_SECRET=replace-with-a-long-random-secret-at-least-24-characters
CODEX_ADMIN_CODE=replace-with-private-admin-code
CODEX_CODE_PREFIX=CXA
CODEX_CODE_TZ_OFFSET_MINUTES=480
QQ_GROUP_LABEL=QQ群：请替换为你的群号
QQ_GROUP_URL=https://qm.qq.com/q/REPLACE_WITH_YOUR_QQ_GROUP_LINK
# Open access: anyone can use the bookmarklet without a daily code.
# Set to false to require the QQ-group daily code again.
OPEN_ACCESS=true
